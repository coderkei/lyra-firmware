+
+/// Return the size in bytes of the inserted SD card image.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_card_size(e: *mut Emu) -> usize {
+    // SAFETY: The caller provides exclusive access to a live emulator.
+    let e = unsafe { &mut *e };
+    e.m.s3_mut().map_or(0, |m| m.bus.periph.sdmmc.card().len())
+}
+
+/// Copy current card contents into caller-owned WebAssembly memory. Returns bytes copied.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_copy_card(e: *mut Emu, ptr: *mut u8, cap: usize) -> usize {
+    // SAFETY: The caller provides exclusive access to a live emulator.
+    let e = unsafe { &mut *e };
+    let Some(m) = e.m.s3_mut() else { return 0 };
+    let card = m.bus.periph.sdmmc.card();
+    if cap < card.len() { return 0; }
+    // SAFETY: The caller provides an output allocation at least as large as the inserted image.
+    unsafe { bytes_mut(ptr, card.len()) }.copy_from_slice(card);
+    card.len()
+}
