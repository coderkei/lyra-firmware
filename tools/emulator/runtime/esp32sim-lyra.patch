index 0000000..2c76b5b
--- /dev/null
+++ b/esp32s3/src/board/lyra_jc3248w535en.rs
@@ -0,0 +1,272 @@
+//! Lyra MP3 player board: JC3248W535EN, AXS15231B QSPI panel and touch controller.
+
+use esp_soc::board::BoardModel;
+use std::sync::{Arc, Mutex};
+
+const WIDTH: usize = 320;
+const HEIGHT: usize = 480;
+
+/// AXS15231B command stream used by the firmware's `esp_lcd` QSPI adapter.
+pub struct Axs15231bPanel {
+    frame: Vec<u16>,
+    pixels_written: u64,
+    frames: u64,
+    stream_bytes: u64,
+    last_frame_bytes: u64,
+    frame_start_pixels: u64,
+    last_frame_pixels: u64,
+    x0: u16,
+    x1: u16,
+    y0: u16,
+    y1: u16,
+    x: u16,
+    y: u16,
+    pending: Option<u8>,
+    pixel_hi: Option<u8>,
+}
+
+impl Axs15231bPanel {
+    fn new() -> Self {
+        Self {
+            frame: vec![0; WIDTH * HEIGHT],
+            pixels_written: 0,
+            frames: 0,
+            stream_bytes: 0,
+            last_frame_bytes: 0,
+            frame_start_pixels: 0,
+            last_frame_pixels: 0,
+            x0: 0,
+            x1: WIDTH as u16 - 1,
+            y0: 0,
+            y1: HEIGHT as u16 - 1,
+            x: 0,
+            y: 0,
+            pending: None,
+            pixel_hi: None,
+        }
+    }
+
+    fn reset(&mut self) {
+        self.frame.fill(0);
+        self.x0 = 0;
+        self.x1 = WIDTH as u16 - 1;
+        self.y0 = 0;
+        self.y1 = HEIGHT as u16 - 1;
+        self.x = 0;
+        self.y = 0;
+        self.pending = None;
+        self.pixel_hi = None;
+        // Keep the host-visible version monotonic and force the UI to publish this cleared frame.
+        self.pixels_written = self.pixels_written.wrapping_add(1);
+    }
+
+    fn transaction(&mut self, tx: &[u8]) {
+        // QSPI commands have a compact 4-byte header. Color DMA chunks are much
+        // larger and may naturally start with the same byte values; do not
+        // mistake RGB565 pixel data for a new command header.
+        let data = if (4..=16).contains(&tx.len()) && matches!(tx[0], 0x02 | 0x32) {
+            let command = tx[2];
+            self.pending = Some(command);
+            if command == 0x2c {
+                self.last_frame_bytes = self.stream_bytes;
+                self.last_frame_pixels = self.pixels_written.saturating_sub(self.frame_start_pixels);
+                self.stream_bytes = 0;
+                self.frame_start_pixels = self.pixels_written;
+                // Lyra's QSPI adapter submits a full-screen frame from row zero
+                // and omits RASET. Start every RAMWR with the complete panel window.
+                self.x0 = 0;
+                self.x1 = WIDTH as u16 - 1;
+                self.y0 = 0;
+                self.y1 = HEIGHT as u16 - 1;
+                self.x = self.x0;
+                self.y = self.y0;
+                self.pixel_hi = None;
+                self.frames = self.frames.wrapping_add(1);
+            }
+            &tx[4..]
+        } else {
+            tx
+        };
+
+        match self.pending {
+            Some(0x2a) if data.len() >= 4 => {
+                self.x0 = u16::from_be_bytes([data[0], data[1]]);
+                self.x1 = u16::from_be_bytes([data[2], data[3]]);
+                self.x = self.x0;
+                self.pending = None;
+            }
+            // esp_lcd sends the QSPI command and parameters as separate transactions.
+            Some(0x2a) => {}
+            Some(0x2b) if data.len() >= 4 => {
+                self.y0 = u16::from_be_bytes([data[0], data[1]]);
+                self.y1 = u16::from_be_bytes([data[2], data[3]]);
+                self.y = self.y0;
+                self.pending = None;
+            }
+            Some(0x2b) => {}
+            Some(0x2c | 0x3c) => self.write_pixels(data),
+            Some(_) => self.pending = None,
+            None => {}
+        }
+    }
+
+    fn write_pixels(&mut self, mut data: &[u8]) {
+        self.stream_bytes = self.stream_bytes.wrapping_add(data.len() as u64);
+        if let Some(high) = self.pixel_hi {
+            let Some((&low, rest)) = data.split_first() else { return };
+            self.pixel_hi = None;
+            self.write_pixel(u16::from_be_bytes([high, low]));
+            data = rest;
+        }
+
+        let (pairs, rest) = data.as_chunks::<2>();
+        for pair in pairs {
+            self.write_pixel(u16::from_be_bytes(*pair));
+        }
+        if let [byte] = rest {
+            self.pixel_hi = Some(*byte);
+        }
+    }
+
+    fn write_pixel(&mut self, pixel: u16) {
+        let x = self.x as usize;
+        let y = self.y as usize;
+        if x < WIDTH && y < HEIGHT {
+            self.frame[y * WIDTH + x] = pixel;
+            self.pixels_written = self.pixels_written.wrapping_add(1);
+        }
+        if self.x >= self.x1 {
+            self.x = self.x0;
+            if self.y >= self.y1 {
+                self.y = self.y0;
+            } else {
+                self.y += 1;
+            }
+        } else {
+            self.x += 1;
+        }
+    }
+}
+
+#[derive(Default, Clone, Copy)]
+struct TouchPoint {
+    down: bool,
+    seen: bool,
+    release_pending: bool,
+    x: u16,
+    y: u16,
+}
+
+/// The board's 0x3B I2C device returns an eight-byte touch report after its 11-byte poll request.
+struct Axs15231bTouch {
+    point: Arc<Mutex<TouchPoint>>,
+    read_index: usize,
+}
+
+impl Axs15231bTouch {
+    fn new(point: Arc<Mutex<TouchPoint>>) -> Self {
+        Self { point, read_index: 0 }
+    }
+}
+
+impl crate::i2c::I2cDevice for Axs15231bTouch {
+    fn start(&mut self, read: bool) -> bool {
+        if read {
+            self.read_index = 0;
+        }
+        true
+    }
+
+    fn write(&mut self, _byte: u8) -> bool {
+        true
+    }
+
+    fn read(&mut self) -> u8 {
+        let index = self.read_index;
+        self.read_index += 1;
+        let mut point = self.point.lock().expect("AXS15231B touch mutex poisoned");
+        if index == 1 {
+            if point.release_pending && point.seen {
+                point.down = false;
+                point.release_pending = false;
+            }
+            if point.down {
+                point.seen = true;
+            }
+        }
+        match index {
+            1 => u8::from(point.down),
+            2 => ((point.x >> 8) as u8) & 0x0f,
+            3 => point.x as u8,
+            4 => ((point.y >> 8) as u8) & 0x0f,
+            5 => point.y as u8,
+            _ => 0,
+        }
+    }
+}
+
+pub struct LyraJc3248w535en {
+    pub panel: Axs15231bPanel,
+    touch: Arc<Mutex<TouchPoint>>,
+    pub spi_transactions: u64,
+}
+
+impl LyraJc3248w535en {
+    pub fn new() -> Self {
+        Self { panel: Axs15231bPanel::new(), touch: Arc::new(Mutex::new(TouchPoint::default())), spi_transactions: 0 }
+    }
+}
+
+impl Default for LyraJc3248w535en { fn default() -> Self { Self::new() } }
+
+impl BoardModel for LyraJc3248w535en {
+    fn name(&self) -> &'static str { "lyra-jc3248w535en" }
+
+    fn reset(&mut self) {
+        self.panel.reset();
+        *self.touch.lock().expect("AXS15231B touch mutex poisoned") = TouchPoint::default();
+    }
+
+    fn spi_transfer(&mut self, host: u8, tx: &[u8], rx_len: usize) -> Vec<u8> {
+        if host == 2 {
+            self.spi_transactions = self.spi_transactions.wrapping_add(1);
+            self.panel.transaction(tx);
+        }
+        vec![0xff; rx_len]
+    }
+
+    fn i2c_devices(&mut self) -> Vec<(u8, u8, Box<dyn crate::i2c::I2cDevice>)> {
+        vec![(0, 0x3b, Box::new(Axs15231bTouch::new(self.touch.clone())))]
+    }
+
+    fn display(&self) -> Option<(u32, u32, Vec<u16>, u64)> {
+        Some((WIDTH as u32, HEIGHT as u32, self.panel.frame.clone(), self.panel.pixels_written))
+    }
+
+    fn display_version(&self) -> u64 { self.panel.pixels_written }
+    fn display_frames(&self) -> u64 { self.panel.frames }
+    fn display_quiet_push(&self) -> bool { true }
+    fn display_push_hz(&self) -> u64 { 60 }
+
+    fn report(&self) -> String {
+        format!("[lyra-panel] spi={} ramwr={} last-frame={} bytes/{} pixels stream={} bytes cursor=({}, {}) window=x{}..{} y{}..{}",
+            self.spi_transactions, self.panel.frames, self.panel.last_frame_bytes,
+            self.panel.last_frame_pixels, self.panel.stream_bytes, self.panel.x, self.panel.y,
+            self.panel.x0, self.panel.x1, self.panel.y0, self.panel.y1)
+    }
+
+    fn touch(&mut self, x: u16, y: u16, down: bool) {
+        let mut point = self.touch.lock().expect("AXS15231B touch mutex poisoned");
+        point.x = x.min(WIDTH as u16 - 1);
+        point.y = y.min(HEIGHT as u16 - 1);
+        if down {
+            point.down = true;
+            point.seen = false;
+            point.release_pending = false;
+        } else if point.seen {
+            point.down = false;
+        } else {
+            point.release_pending = true;
+        }
+    }
+}
