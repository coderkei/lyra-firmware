+/// Insert a raw sector image as the SD card in the ESP32-S3 SDMMC slot. Size must be a multiple
+/// of 512 bytes. Returns 0 on success.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_set_card(e: *mut Emu, ptr: *const u8, len: usize) -> u32 {
+    // SAFETY: The caller provides exclusive access to a live emulator.
+    let e = unsafe { &mut *e };
+    // SAFETY: The caller provides a readable image for this call.
+    let image = unsafe { bytes(ptr, len) };
+    let Some(m) = e.m.s3_mut() else { return 1 };
+    u32::from(!m.bus.periph.sdmmc.set_card(image))
