index 0000000..4045534
--- /dev/null
+++ b/esp32s3/src/sdmmc.rs
@@ -0,0 +1,196 @@
+//! Minimal SD v2 / SDHC card and SDMMC IDMAC model used by the Lyra board.
+//! The card payload is a sector image supplied by the browser at runtime.
+
+use esp_periph::{Device, RegRam, WriteEffect};
+
+const CARD_SECTOR: usize = 512;
+const RINT_CMD_DONE: u32 = 1 << 2;
+const RINT_DATA_OVER: u32 = 1 << 3;
+const RINT_RESPONSE_TIMEOUT: u32 = 1 << 8;
+
+#[derive(Clone, Copy)]
+pub struct PendingCommand {
+    pub index: u8,
+    pub arg: u32,
+    pub flags: u32,
+    pub block_size: usize,
+    pub byte_count: usize,
+}
+
+pub struct CommandResult {
+    pub response: [u32; 4],
+    pub data: Option<Vec<u8>>,
+    pub status: u32,
+}
+
+pub struct Sdmmc {
+    regs: RegRam,
+    card: Vec<u8>,
+    pending: Option<PendingCommand>,
+    app_command: bool,
+    idle: bool,
+    selected: bool,
+    rca: u16,
+}
+
+impl Default for Sdmmc {
+    fn default() -> Self { Self::new() }
+}
+
+impl Sdmmc {
+    pub fn new() -> Self {
+        Self { regs: RegRam::new(), card: Vec::new(), pending: None, app_command: false, idle: true, selected: false, rca: 0x1234 }
+    }
+
+    pub fn set_card(&mut self, image: &[u8]) -> bool {
+        if image.len() < CARD_SECTOR || !image.len().is_multiple_of(CARD_SECTOR) { return false; }
+        self.card.clear();
+        self.card.extend_from_slice(image);
+        self.pending = None;
+        self.app_command = false;
+        self.idle = true;
+        self.selected = false;
+        true
+    }
+
+    pub fn card(&self) -> &[u8] { &self.card }
+    pub fn card_mut(&mut self) -> &mut [u8] { &mut self.card }
+    pub fn take_pending(&mut self) -> Option<PendingCommand> { self.pending.take() }
+    pub fn dma_base(&self) -> u32 { self.regs.read(0x88) }
+    pub fn descriptor_skip(&self) -> u32 { (self.regs.read(0x80) >> 2) & 0x1f }
+    pub fn set_current_descriptor(&mut self, address: u32) { self.regs.write(0x94, address); }
+
+    fn reg(&self, offset: u32) -> u32 {
+        match offset {
+            0x40 => self.regs.read(0x44) & self.regs.read(0x24), // MINTSTS
+            0x50 => u32::from(self.card.is_empty()), // CDETECT: zero means present
+            0x54 => 0, // WRT_PROTECT
+            0x6c => 0x240a, // SDMMC IP version
+            0x70 => 0x0344_4cc3, // HCON defaults from the ESP32-S3 SDMMC block
+            _ => self.regs.read(offset),
+        }
+    }
+
+    fn set_status(&mut self, offset: u32, bits: u32) { self.regs.write(offset, self.regs.read(offset) | bits); }
+
+    pub fn begin_command(&mut self, pending: PendingCommand) -> CommandResult {
+        let was_app = std::mem::take(&mut self.app_command);
+        let mut result = CommandResult { response: [0; 4], data: None, status: 0 };
+        let ready_status = 1 << 8 | 4 << 9; // READY_FOR_DATA, transfer state
+        let mut r1 = if self.idle { 1 << 0 } else { ready_status };
+
+        match pending.index {
+            0 => { self.idle = true; self.selected = false; self.app_command = false; }
+            5 | 52 => result.status = RINT_RESPONSE_TIMEOUT, // A memory-only card has no SDIO function.
+            2 => result.response = self.cid_response(),
+            3 => { self.idle = false; result.response[0] = ((self.rca as u32) << 16) | (ready_status & 0xffff); }
+            6 if was_app => { /* ACMD6: the Lyra host stays in one-bit mode. */ }
+            7 => { self.selected = pending.arg != 0; }
+            8 => result.response[0] = pending.arg & 0xfff,
+            9 => result.response = self.csd_response(),
+            12 => {}
+            13 if was_app => result.data = Some(vec![0; 512]), // ACMD13: SD status
+            13 => result.response[0] = ready_status,
+            16 => {}
+            17 | 18 | 24 | 25 => {
+                let write = matches!(pending.index, 24 | 25);
+                let length = pending.byte_count.min(8 * 1024 * 1024);
+                if !write {
+                    let start = pending.arg as usize * CARD_SECTOR;
+                    let end = start.saturating_add(length);
+                    if start < self.card.len() {
+                        let mut data = vec![0; length];
+                        let copy_end = end.min(self.card.len());
+                        data[..copy_end - start].copy_from_slice(&self.card[start..copy_end]);
+                        result.data = Some(data);
+                    } else {
+                        result.data = Some(vec![0; length]);
+                    }
+                }
+            }
+            23 => {} // SET_BLOCK_COUNT
+            41 if was_app => { self.idle = false; result.response[0] = 0xc0ff_8000; }
+            51 if was_app => result.data = Some(vec![0x02, 0x05, 0, 0, 0, 0, 0, 0]),
+            55 => { self.app_command = true; r1 |= 1 << 5; }
+            _ => {}
+        }
+
+        if pending.index != 2 && pending.index != 9 && pending.index != 3 && pending.index != 8 && pending.index != 41 {
+            result.response[0] = r1;
+        }
+        result
+    }
+
+    pub fn finish_command(&mut self, response: [u32; 4], data_length: usize, write: bool, status: u32) {
+        for (i, word) in response.into_iter().enumerate() { self.regs.write(0x30 + i as u32 * 4, word); }
+        let data = data_length != 0;
+        self.set_status(0x44, RINT_CMD_DONE | (if data { RINT_DATA_OVER } else { 0 }) | status);
+        if data {
+            let count_off = if write { 0x5c } else { 0x60 };
+            self.regs.write(count_off, data_length as u32);
+            self.set_status(0x8c, (1 << 8) | if write { 1 } else { 1 << 1 }); // NIS | TI/RI
+        }
+    }
+
+    fn cid_response(&self) -> [u32; 4] {
+        let mut words = [0; 4];
+        set_bits(&mut words, 120, 8, 0x1d);
+        set_bits(&mut words, 104, 16, u16::from_be_bytes(*b"LY") as u32);
+        for (n, byte) in b"LYRA1".iter().enumerate() { set_bits(&mut words, 96 - n as u32 * 8, 8, *byte as u32); }
+        set_bits(&mut words, 56, 8, 0x10);
+        set_bits(&mut words, 24, 32, 0x3248_5353);
+        set_bits(&mut words, 8, 12, 0x126);
+        set_bits(&mut words, 1, 7, 0x7f);
+        set_bits(&mut words, 0, 1, 1);
+        words
+    }
+
+    fn csd_response(&self) -> [u32; 4] {
+        let mut words = [0; 4];
+        let sectors = (self.card.len() / CARD_SECTOR).max(1024);
+        let units = (sectors / 1024).clamp(1, (1 << 22) as usize);
+        set_bits(&mut words, 126, 2, 1); // CSD v2
+        set_bits(&mut words, 96, 8, 0x32); // 25 MHz
+        set_bits(&mut words, 84, 12, 0x1f5); // read/write, erase and application-specific commands
+        set_bits(&mut words, 48, 22, (units - 1) as u32);
+        set_bits(&mut words, 1, 7, 0x7f);
+        set_bits(&mut words, 0, 1, 1);
+        words
+    }
+}
+
+fn set_bits(words: &mut [u32; 4], start: u32, width: u32, value: u32) {
+    for bit in 0..width {
+        if value & (1 << bit) == 0 { continue; }
+        let target = start + bit;
+        words[(target / 32) as usize] |= 1 << (target % 32);
+    }
+}
+
+impl Device for Sdmmc {
+    fn read(&mut self, offset: u32) -> u32 { self.reg(offset) }
+
+    fn write(&mut self, offset: u32, value: u32) -> WriteEffect {
+        match offset {
+            0x00 => self.regs.write(offset, value & !0x7), // reset bits self-clear
+            0x80 => self.regs.write(offset, value & !1), // IDMAC software reset self-clears
+            0x44 => self.regs.write(offset, self.regs.read(offset) & !value), // RINTSTS is W1C
+            0x8c => self.regs.write(offset, self.regs.read(offset) & !value), // IDSTS is W1C
+            0x2c if value & (1 << 21) != 0 => self.regs.write(offset, value & !(1 << 31)), // clock update
+            0x2c if value & (1 << 31) != 0 => {
+                self.regs.write(offset, value & !(1 << 31));
+                self.pending = Some(PendingCommand {
+                    index: (value & 0x3f) as u8,
+                    arg: self.regs.read(0x28),
+                    flags: value,
+                    block_size: self.regs.read(0x1c) as usize,
+                    byte_count: self.regs.read(0x20) as usize,
+                });
+            }
+            _ => self.regs.write(offset, value),
+        }
+        WriteEffect::NONE
+    }
+
+    fn irq_sources(&self) -> u64 { u64::from((self.regs.read(0x44) & self.regs.read(0x24)) != 0 || (self.regs.read(0x8c) & self.regs.read(0x90)) != 0) }
+}
