+/// Patch whole 512-byte sectors using 520-byte records: sector, version, then sector contents.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_patch_card(e: *mut Emu, ptr: *const u8, len: usize) -> u32 {
+    let e = unsafe { &mut *e };
+    let records = unsafe { bytes(ptr, len) };
+    let Some(m) = e.m.s3_mut() else { return 1 };
+    u32::from(!m.bus.periph.sdmmc.apply_sector_patches(records))
+}
+
+/// Return the number of card sectors changed by guest firmware writes.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_dirty_count(e: *mut Emu) -> usize {
+    let e = unsafe { &mut *e };
+    e.m.s3_mut().map_or(0, |m| m.bus.periph.sdmmc.dirty_sector_count())
+}
+
+/// Copy dirty card sectors to 520-byte records: sector, generation, and 512 bytes of data.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_copy_dirty(e: *mut Emu, ptr: *mut u8, cap: usize) -> usize {
+    let e = unsafe { &mut *e };
+    let Some(m) = e.m.s3_mut() else { return 0 };
+    unsafe { m.bus.periph.sdmmc.copy_dirty_sectors(bytes_mut(ptr, cap)) }
+}
+
+/// Acknowledge saved card sectors; versions prevent a concurrent guest write from being lost.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_sdmmc_ack_dirty(e: *mut Emu, ptr: *const u8, len: usize) {
+    let e = unsafe { &mut *e };
+    let records = unsafe { bytes(ptr, len) };
+    if let Some(m) = e.m.s3_mut() { m.bus.periph.sdmmc.ack_dirty_sectors(records); }
+}
+
+/// Return the size of the emulated SPI flash.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_flash_size(e: *mut Emu) -> usize {
+    let e = unsafe { &mut *e };
+    e.m.s3_mut().map_or(0, |m| m.bus.flash.len())
+}
+
+/// Copy the complete emulated SPI flash into caller-owned WebAssembly memory.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_flash_copy(e: *mut Emu, ptr: *mut u8, cap: usize) -> usize {
+    let e = unsafe { &mut *e };
+    let Some(m) = e.m.s3_mut() else { return 0 };
+    if cap < m.bus.flash.len() { return 0; }
+    unsafe { bytes_mut(ptr, m.bus.flash.len()) }.copy_from_slice(&m.bus.flash);
+    m.bus.flash.len()
+}
+
+/// Return the number of changed 4 KiB flash pages.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_flash_dirty_count(e: *mut Emu) -> usize {
+    let e = unsafe { &mut *e };
+    e.m.s3_mut().map_or(0, |m| m.bus.flash_dirty_page_count())
+}
+
+/// Copy changed 4 KiB flash pages to 4104-byte records: offset, generation, and page data.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_flash_copy_dirty(e: *mut Emu, ptr: *mut u8, cap: usize) -> usize {
+    let e = unsafe { &mut *e };
+    let Some(m) = e.m.s3_mut() else { return 0 };
+    unsafe { m.bus.copy_dirty_flash_pages(bytes_mut(ptr, cap)) }
+}
+
+/// Acknowledge flash pages that were persisted without discarding newer guest writes.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_flash_ack_dirty(e: *mut Emu, ptr: *const u8, len: usize) {
+    let e = unsafe { &mut *e };
+    let records = unsafe { bytes(ptr, len) };
+    if let Some(m) = e.m.s3_mut() { m.bus.ack_dirty_flash_pages(records); }
+}
+
