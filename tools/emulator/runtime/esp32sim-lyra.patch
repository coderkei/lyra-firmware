 impl SocBus {
+    pub(super) fn complete_sdmmc(&mut self) {
+        let Some(command) = self.periph.sdmmc.take_pending() else { return };
+        let result = self.periph.sdmmc.begin_command(command);
+        let mut transferred = 0usize;
+        if result.status == 0 && command.flags & (1 << 9) != 0 {
+            let byte_count = command.byte_count.min(8 * 1024 * 1024);
+            let mut data = result.data.unwrap_or_else(|| vec![0; byte_count]);
+            data.resize(byte_count, 0);
+            let host_writes = command.flags & (1 << 10) != 0;
+            if self.sdmmc_dma_transfer(&mut data, host_writes) {
+                if host_writes && matches!(command.index, 24 | 25) {
+                    let start = command.arg as usize * 512;
+                    let card = self.periph.sdmmc.card_mut();
+                    if start <= card.len() && data.len() <= card.len() - start {
+                        card[start..start + data.len()].copy_from_slice(&data);
+                    }
+                }
+                transferred = byte_count;
+            }
+        }
+        self.periph.sdmmc.finish_command(result.response, transferred, command.flags & (1 << 10) != 0, result.status);
+        self.irq_dirty = true;
+    }
+
+    /// Transfer one SDMMC transaction through IDMAC's linked descriptor list.
+    fn sdmmc_dma_transfer(&mut self, data: &mut [u8], host_writes: bool) -> bool {
+        let mut descriptor = self.periph.sdmmc.dma_base();
+        if descriptor == 0 { return false; }
+        let mut offset = 0usize;
+        let mut steps = 0usize;
+        while offset < data.len() && steps < 4096 {
+            steps += 1;
+            let control = self.read32_unpriced(descriptor).unwrap_or(0);
+            if control & (1 << 31) == 0 { return false; }
+            let sizes = self.read32_unpriced(descriptor + 4).unwrap_or(0);
+            let first_len = (sizes & 0x1fff) as usize;
+            let second_len = ((sizes >> 13) & 0x1fff) as usize;
+            let first = self.read32_unpriced(descriptor + 8).unwrap_or(0);
+            let chained = control & (1 << 4) != 0;
+            let parts = if chained { [(first, first_len), (0, 0)] } else {
+                [(first, first_len), (self.read32_unpriced(descriptor + 12).unwrap_or(0), second_len)]
+            };
+            for (address, length) in parts {
+                if length == 0 || offset == data.len() { continue; }
+                let count = length.min(data.len() - offset);
+                let slice = &mut data[offset..offset + count];
+                let ok = if host_writes { self.read_dma_bytes(address, slice) } else { self.write_dma_bytes(address, slice) };
+                if !ok { return false; }
+                offset += count;
+            }
+            let next = self.read32_unpriced(descriptor + 12).unwrap_or(0);
+            let last = control & (1 << 2) != 0;
+            if self.write32_unpriced(descriptor, control & !(1 << 31)).is_err() { return false; }
+            self.periph.sdmmc.set_current_descriptor(if chained { next } else { descriptor + 16 + self.periph.sdmmc.descriptor_skip() * 4 });
+            descriptor = if chained { next } else { descriptor + 16 + self.periph.sdmmc.descriptor_skip() * 4 };
+            if last && offset < data.len() { return false; }
+            if descriptor == 0 && offset < data.len() { return false; }
+        }
+        offset == data.len()
+    }
+
+    fn read_dma_bytes(&mut self, address: u32, out: &mut [u8]) -> bool {
+        let mut offset = 0usize;
+        while offset < out.len() {
+            if offset + 4 <= out.len() {
+                let Ok(word) = self.read32_unpriced(address + offset as u32) else { return false };
+                out[offset..offset + 4].copy_from_slice(&word.to_le_bytes());
+                offset += 4;
+            } else {
+                let Ok(byte) = self.read8_unpriced(address + offset as u32) else { return false };
+                out[offset] = byte;
+                offset += 1;
+            }
+        }
+        true
+    }
+
+    fn write_dma_bytes(&mut self, address: u32, data: &[u8]) -> bool {
+        let mut offset = 0usize;
+        while offset < data.len() {
+            if offset + 4 <= data.len() {
+                let word = u32::from_le_bytes(data[offset..offset + 4].try_into().unwrap());
+                if self.write32_unpriced(address + offset as u32, word).is_err() { return false; }
+                offset += 4;
+            } else {
+                if self.write8_unpriced(address + offset as u32, data[offset]).is_err() { return false; }
+                offset += 1;
+            }
+        }
+        true
+    }
