CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The ESP32-S3-WROOM-1 quad flash serves every instruction-cache and
# font/rodata miss. QIO moves twice the data per clock of DIO.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Internal RAM is reserved for the audio output task, I2S/SD DMA, the display
# bands and stacks that write flash. Wi-Fi/LWIP packet buffers and TLS
# sessions (16 KiB+ per HTTPS radio stream) go to PSRAM first instead.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Wi-Fi throughput optimisations pin 27+ KiB of driver code in internal RAM.
# Radio streams need well under 1 Mbit/s, so return that RAM to the heap.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Static RX buffers are one contiguous internal DMA block of 1.6 KiB each,
# held from boot. Six matches the block-ack window, as IDF recommends; the
# PSRAM-backed dynamic RX buffers carry the rest. Without these lines the
# SPIRAM preference above raises both to 16 (25.6 KiB internal).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Both cores share the instruction cache. LVGL rendering on one core and the
# audio decoders on the other evicted each other from 16 KiB, which is why
# the GUI slowed further during playback. The extra 16 KiB of internal RAM is
# repaid by keeping the LVGL heap in PSRAM (CONFIG_LV_USE_CUSTOM_MALLOC).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# components/lyra_board/lyra_lvgl_memory.cpp keeps LVGL's heap in PSRAM so
# widgets and draw tasks no longer take internal RAM from audio and DMA.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_USE_TJPGD=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_LV_OBJ_STYLE_CACHE=y
# Themes mix about a dozen corner radii (rows, rims, pills, artwork). Each
# cached circle costs radius * 4 bytes, so keep them all resident instead of
# recomputing anti-aliased corner masks while lists scroll.
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n

# The GUI uses the new ESP-IDF 6.x driver APIs directly.
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# Native audio uses esp_audio_codec for compressed codecs and containers. AIFF
# is handled by Lyra's bounded big-endian PCM reader in lyra_audio.cpp.
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=y
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=y
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=y
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=y
CONFIG_AUDIO_DECODER_PCM_SUPPORT=y
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=y
